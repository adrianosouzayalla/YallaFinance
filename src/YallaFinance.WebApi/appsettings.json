{
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://192.168.15.3:3000",
      "http://192.168.15.5:3000"
    ]
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "YallaFinance",
      "Audience": "YallaFinance.Frontend",
      "LifetimeMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
